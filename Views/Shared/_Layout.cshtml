<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ContaCloud | Sistema Contable Empresarial</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --bs-primary-rgb: 13, 110, 253;
            --brand-green: #00684A;
        }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #fcfcfd;
            color: #2b2f38;
        }
        .navbar-custom {
            background-color: #111827;
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }
        .nav-link {
            font-weight: 500;
            color: #d1d5db !important;
            transition: color 0.2s ease;
        }
        .nav-link:hover {
            color: #ffffff !important;
        }
        .btn-intranet {
            background-color: #10b981;
            color: #ffffff;
            font-weight: 600;
            border-radius: 0.5rem;
            padding: 0.5rem 1.25rem;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-intranet:hover {
            background-color: #059669;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }
        .hero-section {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #ffffff;
            padding: 5rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .feature-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border: 1px solid #e5e7eb;
            border-radius: 1rem;
        }
        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }
        .pricing-card {
            border-radius: 1rem;
            transition: transform 0.2s ease;
            border: 1px solid #e5e7eb;
        }
        .pricing-card.popular {
            border: 2px solid #10b981;
            position: relative;
        }
        .pricing-card:hover {
            transform: translateY(-5px);
        }
        .footer-custom {
            background-color: #111827;
            color: #9ca3af;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar Superior -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-white fs-4" href="@Url.Action("Index", "Home")">
                    <span class="d-inline-flex p-2 bg-success text-white rounded-3 me-2">
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>
                    Conta<span class="text-success">Cloud</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-dismiss="false" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#planes">Planes y Precios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#diagnostico">Estado Base de Datos</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (Session["UsuarioId"] != null || (Request.IsAuthenticated && Session["Nombre"] != null))
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-success"></i>
                                    <span>@Session["Nombre"]</span>
                                    <span class="badge bg-success">@Session["Rol"]</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li><h6 class="dropdown-header">@Session["Correo"]</h6></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#diagnostico"><i class="bi bi-database me-2"></i>Monitoreo MongoDB</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Botón Destacado: Acceso a Intranet -->
                            <a href="@Url.Action("Login", "Account")" class="btn btn-intranet d-flex align-items-center shadow-sm">
                                <i class="bi bi-lock-fill me-2"></i>Acceso a Intranet
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-custom pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold d-flex align-items-center mb-3">
                        <i class="bi bi-journal-bookmark-fill text-success me-2"></i>ContaCloud .NET
                    </h5>
                    <p class="small text-muted mb-3">
                        Plataforma integral de contabilidad corporativa basada en arquitectura sólida .NET Framework 4.8 con base de datos NoSQL MongoDB.
                    </p>
                    <div class="d-flex gap-3 fs-5 text-muted">
                        <a href="#" class="text-muted"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Módulos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#servicios" class="text-decoration-none text-muted">Asientos y Diarios</a></li>
                        <li class="mb-2"><a href="#servicios" class="text-decoration-none text-muted">Plan de Cuentas</a></li>
                        <li class="mb-2"><a href="#servicios" class="text-decoration-none text-muted">Balance General</a></li>
                        <li class="mb-2"><a href="#servicios" class="text-decoration-none text-muted">Auditoría Fiscal</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Enlaces</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action("Login", "Account")" class="text-decoration-none text-muted">Acceso a Intranet</a></li>
                        <li class="mb-2"><a href="#planes" class="text-decoration-none text-muted">Planes y Precios</a></li>
                        <li class="mb-2"><a href="@Url.Action("SeedData", "Account")" class="text-decoration-none text-muted">Inicializar Demo</a></li>
                        <li class="mb-2"><a href="#diagnostico" class="text-decoration-none text-muted">Estado MongoDB</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Soporte y Contacto</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-2 text-success"></i>Av. Financiera 1234, Centro Corporativo</p>
                    <p class="small text-muted mb-1"><i class="bi bi-envelope me-2 text-success"></i>contacto@contacloud.com</p>
                    <p class="small text-muted mb-0"><i class="bi bi-telephone me-2 text-success"></i>+51 (1) 500-2000</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25" />
            <div class="row align-items-center small">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    © @DateTime.Now.Year ContaCloud S.A.C. Todos los derechos reservados.
                </div>
                <div class="col-md-6 text-center text-md-end text-muted">
                    <span>ASP.NET MVC 5</span> | <span>.NET Framework 4.8</span> | <span>MongoDB C# Driver</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
