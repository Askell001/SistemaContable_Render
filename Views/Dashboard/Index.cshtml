@{
    ViewBag.Title = "Panel de Control";
    Layout = "~/Views/Shared/_LayoutIntranet.cshtml";
    var ultimosAsientos = ViewBag.UltimosAsientos as System.Collections.Generic.List<SistemaContable.Models.AsientoContable>;
}

<!-- Banner de Sincronización Automática al Inicio de Sesión -->
@if (Session["UltimaSincronizacion"] != null)
{
    var syncInfo = Session["UltimaSincronizacion"] as SistemaContable.Models.ResultadoSync;
    if (syncInfo != null && syncInfo.Success)
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center p-3 mb-0" role="alert">
                    <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
                    <div class="flex-grow-1">
                        <strong class="d-block text-success-emphasis"><i class="bi bi-arrow-repeat me-1"></i>Bases de Datos Auditadas y Sincronizadas al Iniciar Sesión</strong>
                        <span class="small text-secondary">
                            Fuente seleccionada: <strong class="text-dark">@syncInfo.FuenteUtilizada</strong> |
                            Fecha de datos: <strong class="text-dark font-monospace">@(syncInfo.FechaDatosRestauradosEC.HasValue ? syncInfo.FechaDatosRestauradosEC.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Al día") (UTC-5)</strong> |
                            Documentos actualizados: <span class="badge bg-success">@syncInfo.TotalDocumentos</span>
                        </span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>
    }
}

@{
    string userRol = Session["Rol"] != null ? Session["Rol"].ToString() : "";
    string userEmpresa = Session["Empresa"] != null ? Session["Empresa"].ToString() : "Empresa Principal S.A.";
    bool esAdmin = string.Equals(userRol, "Admin", StringComparison.OrdinalIgnoreCase);
    bool esContador = string.Equals(userRol, "Contador", StringComparison.OrdinalIgnoreCase);
    bool esLector = string.Equals(userRol, "Lectura", StringComparison.OrdinalIgnoreCase) || string.Equals(userRol, "Lector", StringComparison.OrdinalIgnoreCase);
}

<!-- Bienvenida -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <span class="badge bg-success-subtle text-success fw-semibold px-3 py-1 mb-2">Sesión Activa</span>
                    <h2 class="h3 fw-bold mb-1">¡Bienvenido, @ViewBag.NombreUsuario!</h2>
                    <p class="text-muted mb-0">
                        Rol asignado: <strong class="text-dark">@ViewBag.RolUsuario</strong> 
                        @if (esLector)
                        {
                            <span>| Empresa: <strong class="text-success"><i class="bi bi-building me-1"></i>@userEmpresa</strong></span>
                        }
                        <span>| Base de Datos: <code>@ViewBag.DatabaseName</code> (@ViewBag.ActiveConnection)</span>
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @if (esAdmin)
                    {
                        <button type="button" class="btn btn-success btn-sm btn-sync-trigger shadow-sm" title="Ejecutar Auto-Healing Sync">
                            <i class="bi bi-arrow-repeat me-1"></i>Sincronizar Bases de Datos
                        </button>
                        <a href="@Url.Action("Create", "Usuarios")" class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-person-plus me-1"></i>Nuevo Usuario
                        </a>
                        <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-people me-1"></i>Gestionar Usuarios
                        </a>
                    }
                    @if (esContador)
                    {
                        <a href="@Url.Action("NuevoAsiento", "AsientosContables")" class="btn btn-success btn-sm shadow-sm">
                            <i class="bi bi-journal-plus me-1"></i>Nuevo Asiento Contable
                        </a>
                        <a href="@Url.Action("Index", "PlanCuentas")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-diagram-3 me-1"></i>Plan de Cuentas
                        </a>
                        <a href="@Url.Action("Index", "AsientosContables")" class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-journal-check me-1"></i>Ver Asientos
                        </a>
                    }
                    @if (esLector)
                    {
                        <a href="@Url.Action("Index", "Reportes")" class="btn btn-primary btn-sm shadow-sm">
                            <i class="bi bi-file-earmark-bar-graph-fill me-1"></i>Ver Reportes de @userEmpresa
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    @if (esAdmin)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">USUARIOS REGISTRADOS</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalUsuarios ?? 0)</h3>
                        <small class="text-success"><i class="bi bi-shield-lock me-1"></i>Control de Accesos</small>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">BASE DE DATOS</span>
                        <h3 class="fw-bold my-1 text-success font-monospace fs-5">Atlas + Local</h3>
                        <small class="text-success"><i class="bi bi-arrow-repeat me-1"></i>Auto-Healing Sync</small>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-database-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">TOTAL ASIENTOS</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalAsientos ?? 0)</h3>
                        <small class="text-secondary"><i class="bi bi-journal-text me-1"></i>Partida Doble</small>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="bi bi-journal-bookmark-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">NOTIFICACIONES</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalNotificaciones ?? 0)</h3>
                        <small class="text-warning"><i class="bi bi-bell me-1"></i>Alertas del Sistema</small>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="bi bi-bell-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (esContador)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">PLAN DE CUENTAS</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalCuentas ?? 0)</h3>
                        <small class="text-primary"><i class="bi bi-diagram-3 me-1"></i>Catálogo Activo</small>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="bi bi-folder2-open fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">ASIENTOS CONTABLES</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalAsientos ?? 0)</h3>
                        <small class="text-success"><i class="bi bi-journal-text me-1"></i>Partida Doble</small>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-journal-bookmark-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">ESTADO CONTABLE</span>
                        <h3 class="fw-bold my-1 text-success fs-5">Cuadrado (100%)</h3>
                        <small class="text-success"><i class="bi bi-check2-circle me-1"></i>Sin Diferencias</small>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">NOTIFICACIONES</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalNotificaciones ?? 0)</h3>
                        <small class="text-warning"><i class="bi bi-bell me-1"></i>Alertas</small>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="bi bi-bell-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">EMPRESA ASOCIADA</span>
                        <h4 class="fw-bold my-1 text-success text-truncate" title="@userEmpresa">@userEmpresa</h4>
                        <small class="text-muted"><i class="bi bi-building me-1"></i>Reportes Exclusivos</small>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">ASIENTOS DE TU EMPRESA</span>
                        <h3 class="fw-bold my-1 text-dark">@(ViewBag.TotalAsientos ?? 0)</h3>
                        <small class="text-primary"><i class="bi bi-journal-text me-1"></i>Visibles para Reportes</small>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-file-earmark-spreadsheet-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">FORMATOS DISPONIBLES</span>
                        <h3 class="fw-bold my-1 text-dark">Excel, PDF, XML</h3>
                        <small class="text-success"><i class="bi bi-download me-1"></i>Descarga Directa</small>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="bi bi-file-earmark-arrow-down fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Accesos Rápidos y Actividad -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history text-success me-2"></i>
                    @(esLector ? ("Últimos Asientos de " + userEmpresa) : "Últimos Asientos Contables")
                </h5>
                <span class="badge bg-light text-muted border">MongoDB: asientosContables</span>
            </div>

            @if (ultimosAsientos != null && ultimosAsientos.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># Asiento</th>
                                <th>Fecha</th>
                                <th>Concepto / Glosa</th>
                                <th>Empresa</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asiento in ultimosAsientos)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@asiento.NumeroAsiento</span></td>
                                    <td>@asiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@asiento.Concepto</td>
                                    <td><small class="badge bg-light text-dark border">@(string.IsNullOrEmpty(asiento.Empresa) ? "Empresa Principal S.A." : asiento.Empresa)</small></td>
                                    <td>
                                        @if (asiento.Estado == "Aprobado")
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else if (asiento.Estado == "Anulado")
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Borrador</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x fs-1 text-secondary opacity-50 d-block mb-2"></i>
                    <p class="mb-0">No se han registrado asientos contables aún.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Accesos Rápidos</h5>
            <div class="d-grid gap-2">
                @if (esAdmin)
                {
                    <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-primary text-start p-3 rounded-3 shadow-xs">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-people-fill fs-3 text-primary me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Gestión de Usuarios</div>
                                <small class="text-muted">Crear y administrar usuarios y empresas</small>
                            </div>
                        </div>
                    </a>
                    <button type="button" class="btn btn-outline-success text-start p-3 rounded-3 shadow-xs btn-sync-trigger">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-arrow-repeat fs-3 text-success me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Sincronizar Bases de Datos</div>
                                <small class="text-muted">Auto-Healing Sync (Atlas, Local y JSON)</small>
                            </div>
                        </div>
                    </button>
                }
                @if (esContador)
                {
                    <a href="@Url.Action("NuevoAsiento", "AsientosContables")" class="btn btn-outline-primary text-start p-3 rounded-3 shadow-xs">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-journal-plus fs-3 text-primary me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Nuevo Asiento Contable</div>
                                <small class="text-muted">Registro con partida doble obligatoria</small>
                            </div>
                        </div>
                    </a>
                    <a href="@Url.Action("Index", "PlanCuentas")" class="btn btn-outline-info text-start p-3 rounded-3 shadow-xs">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-diagram-3-fill fs-3 text-info me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Plan de Cuentas</div>
                                <small class="text-muted">Catálogo contable clasificado</small>
                            </div>
                        </div>
                    </a>
                    <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-success text-start p-3 rounded-3 shadow-xs">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-bar-graph-fill fs-3 text-success me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Generador de Reportes</div>
                                <small class="text-muted">Exportar a Excel, PDF y XML</small>
                            </div>
                        </div>
                    </a>
                }
                @if (esLector)
                {
                    <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-success text-start p-3 rounded-3 shadow-xs">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-bar-graph-fill fs-3 text-success me-3"></i>
                            <div>
                                <div class="fw-bold text-dark">Reportes de @userEmpresa</div>
                                <small class="text-muted">Consultar y descargar reportes</small>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- SECCIÓN DE REPORTES CONTABLES EN EL DASHBOARD -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-printer-fill text-primary me-2"></i>Reportes de Asientos Contables
                    </h5>
                    <p class="text-muted small mb-0">Filtra por rango de fechas y estado para descargar directamente en tu navegador.</p>
                </div>
                <a href="@Url.Action("Index", "Reportes")" class="btn btn-sm btn-outline-primary fw-semibold">
                    <i class="bi bi-arrows-fullscreen me-1"></i>Abrir Módulo Completo
                </a>
            </div>

            <div class="p-3 bg-light rounded-4 border">
                @using (Html.BeginForm("Exportar", "Reportes", FormMethod.Post, new { @class = "row g-3 align-items-end" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary">Fecha Inicio</label>
                        <input type="date" name="fechaInicio" class="form-control bg-white" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary">Fecha Fin</label>
                        <input type="date" name="fechaFin" class="form-control bg-white" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary">Estado</label>
                        <select name="estado" class="form-select bg-white">
                            <option value="Todos">Todos los Estados</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Borrador">Borrador</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" name="formato" value="excel" class="btn btn-success flex-grow-1 fw-bold" title="Descargar Excel en el navegador">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i>Excel
                        </button>
                        <button type="submit" name="formato" value="pdf" class="btn btn-danger flex-grow-1 fw-bold" title="Descargar PDF en el navegador">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>PDF
                        </button>
                        <button type="submit" name="formato" value="xml" class="btn btn-warning flex-grow-1 fw-bold text-dark" title="Descargar XML en el navegador">
                            <i class="bi bi-file-earmark-code-fill me-1"></i>XML
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
