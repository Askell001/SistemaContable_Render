@model IEnumerable<SistemaContable.Models.AsientoComprobanteDto>
@{
    ViewBag.Title = "Historial de Asientos Contables";
    Layout = "~/Views/Shared/_LayoutIntranet.cshtml";

    string search = ViewBag.Search as string;
    string selectedEstado = ViewBag.SelectedEstado as string;
    string fechaInicio = ViewBag.FechaInicio as string;
    string fechaFin = ViewBag.FechaFin as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1">
            <i class="bi bi-journal-bookmark-fill text-success me-2"></i>Historial de Asientos Contables
        </h2>
        <p class="text-muted mb-0 small">Libro Diario y pólizas registradas con partida doble en MongoDB (Total: @(Model != null ? Model.Count() : 0) asientos)</p>
    </div>
    <div>
        <a href="@Url.Action("NuevoAsiento", "AsientosContables")" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i>Nuevo Asiento Contable
        </a>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        @using (Html.BeginForm("Index", "AsientosContables", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">N° Asiento o Glosa</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Ej: 101 o Pago..." />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="Aprobado" @(selectedEstado == "Aprobado" ? "selected" : "")>Aprobado</option>
                    <option value="Borrador" @(selectedEstado == "Borrador" ? "selected" : "")>Borrador</option>
                    <option value="Anulado" @(selectedEstado == "Anulado" ? "selected" : "")>Anulado</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Desde</label>
                <input type="date" name="fechaInicio" value="@fechaInicio" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Hasta</label>
                <input type="date" name="fechaFin" value="@fechaFin" class="form-control" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a href="@Url.Action("Index", "AsientosContables")" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- Tabla de Asientos Contables -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" style="width: 120px;">N° Asiento</th>
                    <th style="width: 130px;">Fecha</th>
                    <th>Concepto / Glosa</th>
                    <th>Autor / Usuario</th>
                    <th class="text-end" style="width: 130px;">Total Debe</th>
                    <th class="text-end" style="width: 130px;">Total Haber</th>
                    <th class="text-center" style="width: 120px;">Estado</th>
                    <th class="text-end pe-4" style="width: 130px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var a in Model)
                    {
                        <tr class="@(a.Estado == "Anulado" ? "opacity-75 bg-light" : "")">
                            <td class="ps-4">
                                <span class="badge bg-secondary font-monospace fs-6">#@a.NumeroAsiento</span>
                            </td>
                            <td class="text-secondary small">
                                @a.Fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@a.Concepto</div>
                                <small class="text-muted font-monospace" style="font-size: 0.72rem;">ID: @a.Id</small>
                            </td>
                            <td class="small text-secondary">
                                <i class="bi bi-person me-1"></i>@a.NombreUsuario
                            </td>
                            <td class="text-end font-monospace fw-bold text-dark">
                                $@a.TotalDebe.ToString("N2")
                            </td>
                            <td class="text-end font-monospace fw-bold text-dark">
                                $@a.TotalHaber.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (a.Estado == "Aprobado")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Aprobado
                                    </span>
                                }
                                else if (a.Estado == "Anulado")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 px-2 py-1">
                                        <i class="bi bi-slash-circle me-1"></i>Anulado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning border-opacity-25 px-2 py-1">
                                        <i class="bi bi-pencil me-1"></i>Borrador
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Detalle", "AsientosContables", new { id = a.Id })" class="btn btn-outline-primary" title="Ver Comprobante">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (a.Estado != "Anulado")
                                    {
                                        using (Html.BeginForm("Anular", "AsientosContables", new { id = a.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Anular Asiento (Auditoría)" onclick="return confirm('¿Está seguro de ANULAR el asiento contable #@a.NumeroAsiento? El registro no será eliminado pero se marcará como Anulado.');">
                                                <i class="bi bi-x-octagon"></i>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-2 fw-semibold">No se encontraron asientos contables.</p>
                            <a href="@Url.Action("NuevoAsiento", "AsientosContables")" class="btn btn-sm btn-success">
                                <i class="bi bi-plus-lg me-1"></i>Registrar Primer Asiento
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
