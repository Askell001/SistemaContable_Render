@model SistemaContable.Models.UsuarioItemDto
@{
    ViewBag.Title = "Desactivar Usuario";
    Layout = "~/Views/Shared/_LayoutIntranet.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-danger text-white py-3 px-4">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Desactivación (Eliminación Lógica)
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-start mb-4">
                    <i class="bi bi-shield-exclamation fs-3 me-3 flex-shrink-0 text-warning"></i>
                    <div class="small">
                        <strong>Aviso de Eliminación Lógica:</strong>
                        <p class="mb-0 mt-1">El documento en MongoDB <strong>no será eliminado físicamente</strong> para mantener la integridad referencial y el historial de auditoría de los asientos contables. Su estado cambiará a <strong>Inactivo</strong> impidiendo el acceso a la plataforma.</p>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border mb-4">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4 text-muted">ID de MongoDB:</dt>
                        <dd class="col-sm-8 font-monospace text-dark">@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Nombre:</dt>
                        <dd class="col-sm-8 fw-bold text-dark">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Correo:</dt>
                        <dd class="col-sm-8 text-dark">@Model.Correo</dd>

                        <dt class="col-sm-4 text-muted">Rol:</dt>
                        <dd class="col-sm-8 text-dark"><span class="badge bg-secondary">@Model.NombreRol</span></dd>

                        <dt class="col-sm-4 text-muted">Estado Actual:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>

                @using (Html.BeginForm("Delete", "Usuarios", new { id = Model.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "Usuarios")" class="btn btn-light px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                            <i class="bi bi-slash-circle me-1"></i>Confirmar Desactivación
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
