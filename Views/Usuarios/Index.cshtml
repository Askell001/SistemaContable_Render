@model IEnumerable<SistemaContable.Models.UsuarioItemDto>
@{
    ViewBag.Title = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_LayoutIntranet.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    long totalRecords = ViewBag.TotalRecords ?? 0;
    string search = ViewBag.Search as string;
    string selectedRolId = ViewBag.SelectedRolId as string;
    bool? selectedEstado = ViewBag.SelectedEstado as bool?;
    var rolesList = ViewBag.RolesList as IEnumerable<SelectListItem>;
}

<!-- Encabezado de Página -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1">
            <i class="bi bi-people-fill text-success me-2"></i>Gestión de Usuarios
        </h2>
        <p class="text-muted mb-0 small">Administra los accesos, roles y estados de los usuarios en MongoDB (Total: @totalRecords registros)</p>
    </div>
    <div>
        <a href="@Url.Action("Create", "Usuarios")" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i>Nuevo Usuario
        </a>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        @using (Html.BeginForm("Index", "Usuarios", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Buscar por Nombre o Correo</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Ej. Juan Pérez o correo corporativo" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Filtrar por Rol</label>
                <select name="rolId" class="form-select">
                    <option value="">-- Todos los Roles --</option>
                    @if (rolesList != null)
                    {
                        foreach (var rol in rolesList)
                        {
                            <option value="@rol.Value" @(rol.Value == selectedRolId ? "selected" : "")>@rol.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos los Estados --</option>
                    <option value="true" @(selectedEstado == true ? "selected" : "")>Solo Activos</option>
                    <option value="false" @(selectedEstado == false ? "selected" : "")>Solo Inactivos</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel-fill me-1"></i>Filtrar
                </button>
                <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-secondary" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- Tabla de Usuarios -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Usuario / Nombre</th>
                    <th>Correo Electrónico</th>
                    <th>Rol Asignado</th>
                    <th>Empresa Asignada</th>
                    <th>Estado</th>
                    <th>Fecha de Registro</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-light border text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        @(string.IsNullOrEmpty(item.Nombre) ? "U" : item.Nombre.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.Nombre</div>
                                        <small class="text-muted font-monospace" style="font-size: 0.72rem;">ID: @item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@item.Correo" class="text-decoration-none text-secondary">
                                    <i class="bi bi-envelope me-1"></i>@item.Correo
                                </a>
                            </td>
                            <td>
                                @if (item.NombreRol == "Admin")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                        <i class="bi bi-shield-fill-check me-1"></i>Admin
                                    </span>
                                }
                                else if (item.NombreRol == "Contador")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                        <i class="bi bi-calculator me-1"></i>Contador
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                        <i class="bi bi-eye me-1"></i>@(item.NombreRol ?? "Lectura")
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-building me-1 text-secondary"></i>@(string.IsNullOrEmpty(item.Empresa) ? "Empresa Principal S.A." : item.Empresa)
                                </span>
                            </td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i>Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="@Url.Action("Edit", "Usuarios", new { id = item.Id })" class="btn btn-outline-primary" title="Editar Usuario">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    @using (Html.BeginForm("ToggleEstado", "Usuarios", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(item.Estado ? "btn-outline-warning" : "btn-outline-success")" title="@(item.Estado ? "Desactivar Usuario" : "Reactivar Usuario")" onclick="return confirm('¿Desea cambiar el estado del usuario @item.Nombre?');">
                                            <i class="bi @(item.Estado ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    }

                                    <a href="@Url.Action("Delete", "Usuarios", new { id = item.Id })" class="btn btn-outline-danger" title="Eliminación Lógica">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-1 fw-semibold">No se encontraron usuarios.</p>
                            <small>Prueba ajustando los filtros de búsqueda o crea uno nuevo.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3 px-4">
            <span class="small text-muted">
                Página <strong>@currentPage</strong> de <strong>@totalPages</strong>
            </span>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Usuarios", new { search = search, rolId = selectedRolId, estado = selectedEstado, page = currentPage - 1 })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Usuarios", new { search = search, rolId = selectedRolId, estado = selectedEstado, page = p })">@p</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Usuarios", new { search = search, rolId = selectedRolId, estado = selectedEstado, page = currentPage + 1 })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
