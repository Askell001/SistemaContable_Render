@model IEnumerable<SistemaContable.Models.CuentaContable>
@{
    ViewBag.Title = "Plan de Cuentas Contables";
    Layout = "~/Views/Shared/_LayoutIntranet.cshtml";

    string search = ViewBag.Search as string;
    string selectedTipo = ViewBag.SelectedTipo as string;
    long totalCuentas = ViewBag.TotalCuentas ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Plan y Catálogo de Cuentas
        </h2>
        <p class="text-muted mb-0 small">Estructura contable jerárquica para pólizas y balances (Total: @totalCuentas cuentas registradas)</p>
    </div>
    <div class="d-flex gap-2">
        @if (totalCuentas == 0)
        {
            <a href="@Url.Action("SeedCatalogo", "PlanCuentas")" class="btn btn-outline-primary shadow-sm" onclick="return confirm('¿Desea inicializar el Plan de Cuentas estándar (Activo, Pasivo, Patrimonio, Ingresos, Gastos)?');">
                <i class="bi bi-database-fill-add me-1"></i>Inicializar Catálogo Estándar
            </a>
        }
        <a href="@Url.Action("Create", "PlanCuentas")" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i>Nueva Cuenta
        </a>
    </div>
</div>

<!-- Barra de Filtros -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        @using (Html.BeginForm("Index", "PlanCuentas", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Buscar por Código o Nombre</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Ej. 1.1.01 o Caja..." />
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Tipo de Cuenta</label>
                <select name="tipo" class="form-select">
                    <option value="">-- Todos los Tipos --</option>
                    <option value="Activo" @(selectedTipo == "Activo" ? "selected" : "")>Activo</option>
                    <option value="Pasivo" @(selectedTipo == "Pasivo" ? "selected" : "")>Pasivo</option>
                    <option value="Patrimonio" @(selectedTipo == "Patrimonio" ? "selected" : "")>Patrimonio</option>
                    <option value="Ingreso" @(selectedTipo == "Ingreso" ? "selected" : "")>Ingreso</option>
                    <option value="Gasto" @(selectedTipo == "Gasto" ? "selected" : "")>Gasto</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a href="@Url.Action("Index", "PlanCuentas")" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- Tabla de Cuentas -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" style="width: 140px;">Código</th>
                    <th>Nombre de la Cuenta</th>
                    <th>Tipo</th>
                    <th>Nivel</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        string paddingLeft = ((c.Nivel - 1) * 20) + "px";
                        <tr>
                            <td class="ps-4 font-monospace fw-bold text-dark">
                                @c.Codigo
                            </td>
                            <td>
                                <div style="padding-left: @paddingLeft;">
                                    @if (c.Nivel == 1)
                                    {
                                        <strong class="text-uppercase text-dark fs-6">@c.Nombre</strong>
                                    }
                                    else if (c.Nivel == 2)
                                    {
                                        <span class="fw-semibold text-secondary">@c.Nombre</span>
                                    }
                                    else
                                    {
                                        <span class="text-dark">@c.Nombre</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (c.Tipo == "Activo")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 px-2 py-1">Activo</span>
                                }
                                else if (c.Tipo == "Pasivo")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 px-2 py-1">Pasivo</span>
                                }
                                else if (c.Tipo == "Patrimonio")
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning border-opacity-25 px-2 py-1">Patrimonio</span>
                                }
                                else if (c.Tipo == "Ingreso")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1">Ingreso</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-25 px-2 py-1">Gasto</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-muted border">Nivel @c.Nivel</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Edit", "PlanCuentas", new { id = c.Id })" class="btn btn-outline-primary" title="Editar Cuenta">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @using (Html.BeginForm("Delete", "PlanCuentas", new { id = c.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar Cuenta" onclick="return confirm('¿Está seguro de eliminar la cuenta contable @c.Codigo - @c.Nombre?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-2 fw-semibold">No se encontraron cuentas contables.</p>
                            <a href="@Url.Action("SeedCatalogo", "PlanCuentas")" class="btn btn-sm btn-primary">
                                <i class="bi bi-database-fill-add me-1"></i>Generar Catálogo Estándar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
