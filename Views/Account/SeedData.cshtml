@{
    ViewBag.Title = "Inicialización de Datos de Prueba";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow border-0 rounded-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-database-check text-success me-2"></i>Inicialización de Base de Datos MongoDB</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Resultado de la operación:</strong>
                        <div class="mt-1">@ViewBag.SeedResult</div>
                    </div>
                </div>

                <div class="mt-4">
                    <h6 class="fw-bold">Datos de Acceso Creados:</h6>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Correo electrónico</span>
                            <span class="badge bg-primary fs-6">admin@contable.com</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Contraseña</span>
                            <span class="badge bg-dark fs-6">Admin123*</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Rol asignado</span>
                            <span class="badge bg-success fs-6">Admin</span>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-success flex-grow-1">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Ir a Iniciar Sesión
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-1"></i>Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
