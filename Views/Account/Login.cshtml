@model SistemaContable.Models.LoginViewModel
@{
    ViewBag.Title = "Acceso a Intranet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-2" style="width: 54px; height: 54px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h4 class="fw-bold mb-1">Acceso a Intranet</h4>
                <p class="text-white-50 small mb-0">Sistema Contable Empresarial .NET &amp; MongoDB</p>
            </div>

            <div class="card-body p-4 p-md-5">
                @if (ViewBag.MensajeInfo != null || TempData["MensajeInfo"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-info-circle-fill fs-5 me-2 flex-shrink-0"></i>
                        <div>@(ViewBag.MensajeInfo ?? TempData["MensajeInfo"])</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["MensajeExito"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 me-2 flex-shrink-0"></i>
                        <div>@TempData["MensajeExito"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
                        <div>
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="Correo" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-envelope me-1"></i>Correo Electrónico
                        </label>
                        @Html.TextBoxFor(m => m.Correo, new { 
                            @class = "form-control form-control-lg", 
                            placeholder = "ejemplo@empresa.com", 
                            type = "email",
                            required = "required",
                            autocomplete = "username"
                        })
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="Password" class="form-label fw-semibold text-secondary mb-0">
                                <i class="bi bi-key me-1"></i>Contraseña
                            </label>
                        </div>
                        <div class="input-group mt-1">
                            @Html.PasswordFor(m => m.Password, new { 
                                @class = "form-control form-control-lg", 
                                placeholder = "••••••••", 
                                required = "required",
                                autocomplete = "current-password",
                                id = "txtPassword"
                            })
                            <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword" title="Mostrar/Ocultar contraseña">
                                <i class="bi bi-eye" id="iconToggle"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="form-check mb-4">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "chkRemember" })
                        <label class="form-check-label text-secondary small" for="chkRemember">
                            Mantener sesión iniciada
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar al Sistema
                        </button>
                    </div>
                }

                <div class="text-center mt-4 pt-3 border-top">
                    <div class="bg-light p-3 rounded-3 text-start small">
                        <div class="fw-bold text-dark mb-1">
                            <i class="bi bi-info-circle text-primary me-1"></i>Credenciales de Demostración:
                        </div>
                        <div><strong>Usuario:</strong> <code>admin@contable.com</code></div>
                        <div><strong>Contraseña:</strong> <code>Admin123*</code></div>
                        <div class="mt-2 text-end">
                            <a href="@Url.Action("SeedData", "Account")" class="text-decoration-none small text-primary fw-semibold">
                                <i class="bi bi-database-gear me-1"></i>¿BD vacía? Inicializar Demo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-light text-center py-3">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Regresar al Sitio Principal
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toggleBtn = document.getElementById("btnTogglePassword");
        var pwdInput = document.getElementById("txtPassword");
        var icon = document.getElementById("iconToggle");

        if (toggleBtn && pwdInput && icon) {
            toggleBtn.addEventListener("click", function () {
                if (pwdInput.type === "password") {
                    pwdInput.type = "text";
                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");
                } else {
                    pwdInput.type = "password";
                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");
                }
            });
        }
    });
</script>
