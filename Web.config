<configuration>
  <connectionStrings>
    <!-- Cadena de Conexión Local -->
    <add name="MongoLocal" connectionString="mongodb://localhost:27017" />
    <!-- Cadena de Conexión en la Nube (MongoDB Atlas) -->
    <add name="MongoAtlas" connectionString="mongodb+srv://user:12345@registrousuarios.e6jeny6.mongodb.net/" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- Selector de Conexión Activa: 'MongoAtlas' o 'MongoLocal' -->
    <add key="ActiveMongoConnection" value="MongoAtlas" />
    <!-- Nombre de la Base de Datos Principal -->
    <add key="MongoDatabaseName" value="ContabilidadDB" />
  </appSettings>
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="2880" />
    </authentication>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-ES" uiCulture="es-ES" />
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" executionTimeout="300" maxRequestLength="20480" />
    <customErrors mode="Off" />
  </system.web>
